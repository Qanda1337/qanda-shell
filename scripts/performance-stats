#!/usr/bin/env bash

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
cpu_cache="$runtime_dir/qanda-shell-performance-cpu"
io_cache="$runtime_dir/qanda-shell-performance-io"

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_total=$((idle + iowait))

cpu=0
if [[ -r "$cpu_cache" ]]; then
    read -r previous_total previous_idle < "$cpu_cache"
    delta_total=$((total - previous_total))
    delta_idle=$((idle_total - previous_idle))
    if ((delta_total > 0)); then
        cpu=$(((delta_total - delta_idle) * 100 / delta_total))
    fi
fi

disk_total=0
disk_used=0
disk_available=0
disk_percent=0
disk_device=""
read -r disk_device disk_total disk_used disk_available disk_percent _ < <(LC_ALL=C df -P -B1 / | tail -n 1)
disk_percent=${disk_percent%%%}

network_interface=$(ip -j route show default 2>/dev/null | jq -r '.[0].dev // ""')
rx_total=0
tx_total=0
if [[ -n "$network_interface" ]]; then
    [[ -r "/sys/class/net/$network_interface/statistics/rx_bytes" ]] && rx_total=$(<"/sys/class/net/$network_interface/statistics/rx_bytes")
    [[ -r "/sys/class/net/$network_interface/statistics/tx_bytes" ]] && tx_total=$(<"/sys/class/net/$network_interface/statistics/tx_bytes")
fi

now_ms=$(date +%s%3N)
rx_rate=0
tx_rate=0
if [[ -r "$io_cache" ]]; then
    read -r previous_ms previous_rx previous_tx < "$io_cache"
    elapsed=$((now_ms - previous_ms))
    if ((elapsed > 0)); then
        rx_rate=$(((rx_total - previous_rx) * 1000 / elapsed))
        tx_rate=$(((tx_total - previous_tx) * 1000 / elapsed))
        ((rx_rate < 0)) && rx_rate=0
        ((tx_rate < 0)) && tx_rate=0
    fi
fi
printf '%s %s %s\n' "$now_ms" "$rx_total" "$tx_total" > "$io_cache"

processes_json=$(
    ps -eo pid=,comm=,pcpu=,pmem=,rss= --sort=-pcpu | head -n 5 |
    while read -r pid name process_cpu process_memory rss; do
        jq -cn --argjson pid "$pid" --arg name "$name" \
            --argjson cpu "${process_cpu:-0}" --argjson memory "${process_memory:-0}" \
            --argjson rss "$((rss * 1024))" \
            '{pid:$pid,name:$name,cpuPercent:$cpu,memoryPercent:$memory,rssBytes:$rss}'
    done | jq -sc '.'
)
printf '%s %s\n' "$total" "$idle_total" > "$cpu_cache"

mem_total=0
mem_available=0
swap_total=0
swap_free=0
while read -r key value _; do
    case "$key" in
        MemTotal:) mem_total=$value ;;
        MemAvailable:) mem_available=$value ;;
        SwapTotal:) swap_total=$value ;;
        SwapFree:) swap_free=$value ;;
    esac
done < /proc/meminfo

mem_used=$((mem_total - mem_available))
memory=$((mem_total > 0 ? mem_used * 100 / mem_total : 0))
swap_used=$((swap_total - swap_free))
swap=$((swap_total > 0 ? swap_used * 100 / swap_total : 0))

cpu_temp=0
for label in /sys/class/hwmon/hwmon*/temp*_label; do
    [[ -r "$label" ]] || continue
    if grep -Eqi 'package id 0|tctl|tdie' "$label"; then
        input="${label%_label}_input"
        if [[ -r "$input" ]]; then
            value=$(<"$input")
            cpu_temp=$((value / 1000))
            break
        fi
    fi
done

gpu=0
gpu_temp=0
gpu_mem_used=0
gpu_mem_total=0
if command -v nvidia-smi >/dev/null 2>&1; then
    IFS=',' read -r gpu gpu_temp gpu_mem_used gpu_mem_total < <(
        nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total \
            --format=csv,noheader,nounits 2>/dev/null | sed 's/ //g' | head -n 1
    )
else
    for hwmon in /sys/class/hwmon/hwmon*; do
        [[ -r "$hwmon/name" ]] || continue
        [[ "$(<"$hwmon/name")" == "amdgpu" ]] || continue
        [[ -r "$hwmon/temp1_input" ]] && gpu_temp=$(($(<"$hwmon/temp1_input") / 1000))
        [[ -r "$hwmon/device/gpu_busy_percent" ]] && gpu=$(<"$hwmon/device/gpu_busy_percent")
        break
    done
fi

jq -cn \
    --argjson cpu "${cpu:-0}" \
    --argjson gpu "${gpu:-0}" \
    --argjson memory "$memory" \
    --argjson swap "$swap" \
    --argjson cpuTemp "$cpu_temp" \
    --argjson gpuTemp "${gpu_temp:-0}" \
    --argjson memoryUsed "$((mem_used * 1024))" \
    --argjson memoryTotal "$((mem_total * 1024))" \
    --argjson swapUsed "$((swap_used * 1024))" \
    --argjson swapTotal "$((swap_total * 1024))" \
    --argjson gpuMemoryUsed "${gpu_mem_used:-0}" \
    --argjson gpuMemoryTotal "${gpu_mem_total:-0}" \
    --arg diskDevice "$disk_device" \
    --argjson diskTotal "${disk_total:-0}" \
    --argjson diskUsed "${disk_used:-0}" \
    --argjson diskAvailable "${disk_available:-0}" \
    --argjson diskPercent "${disk_percent:-0}" \
    --arg networkInterface "$network_interface" \
    --argjson rxRate "$rx_rate" \
    --argjson txRate "$tx_rate" \
    --argjson rxTotal "$rx_total" \
    --argjson txTotal "$tx_total" \
    --argjson processes "${processes_json:-[]}" \
    '{cpu:$cpu,gpu:$gpu,memory:$memory,swap:$swap,cpuTemp:$cpuTemp,gpuTemp:$gpuTemp,memoryUsed:$memoryUsed,memoryTotal:$memoryTotal,swapUsed:$swapUsed,swapTotal:$swapTotal,gpuMemoryUsed:$gpuMemoryUsed,gpuMemoryTotal:$gpuMemoryTotal,disk:{device:$diskDevice,totalBytes:$diskTotal,usedBytes:$diskUsed,availableBytes:$diskAvailable,usedPercent:$diskPercent},network:{interface:$networkInterface,rxBytesPerSecond:$rxRate,txBytesPerSecond:$txRate,rxBytesTotal:$rxTotal,txBytesTotal:$txTotal},processes:$processes}'
